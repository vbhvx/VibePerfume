# VibePerfume Backend Environment Configuration
PORT=5050
NODE_ENV=development

# Atelier Administration Security Key
# Protects /api/admin/* and catalog mutations (POST/PUT/DELETE /api/products)
ADMIN_API_KEY=vibe-atelier-admin-key-2026

# Allowed CORS Origins (comma-separated; omit or leave empty to allow local dev origins)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: MongoDB URI (only if migrating away from the built-in atomic JSON store)
# MONGODB_URI=mongodb://localhost:27017/vibe_perfume
